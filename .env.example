# Copy to `.env` and adjust. Compose reads these automatically;
# adapter examples and migration runs honor the DATABASE_URL_* values.
# `.env` is gitignored; this file documents every variable.

# Postgres (Compose service `postgres`)
POSTGRES_USER=rolify
POSTGRES_PASSWORD=rolify
POSTGRES_DB=rolify
POSTGRES_PORT=5432
DATABASE_URL_POSTGRES=postgres://rolify:rolify@localhost:5432/rolify

# MySQL (Compose service `mysql`)
MYSQL_ROOT_PASSWORD=rolify
MYSQL_DATABASE=rolify
MYSQL_PORT=3306
DATABASE_URL_MYSQL=mysql://root:rolify@localhost:3306/rolify

# MongoDB (Compose service `mongo`)
MONGO_INITDB_ROOT_USERNAME=rolify
MONGO_INITDB_ROOT_PASSWORD=rolify
MONGO_PORT=27017
DATABASE_URL_MONGO=mongodb://rolify:rolify@localhost:27017/rolify
